{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/integration/v1/health", "destination": "/api/integration/v1/health.json" },
    { "source": "/api/integration/v1/capabilities", "destination": "/api/integration/v1/capabilities.json" }
  ],
  "headers": [
    { "source": "/api/integration/v1/(.*)", "headers": [
      { "key": "Cache-Control", "value": "no-store, max-age=0" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
  ]
}
