{
  "schema": "rosevear.integration.discovery.v1",
  "manifest_version": "1.1.0",
  "source_id": "yw",
  "source_app_id": "yard-workers",
  "source_role": "business_shell",
  "repository": "RosevearCreations/yw",
  "source_revision": null,
  "source_revision_state": "HOLD_UNVERIFIED_SOURCE_REVISION",
  "source_revision_binding": {
    "production": "build_time_vercel_git_commit_sha",
    "condition": "VERCEL_ENV=production AND VERCEL_GIT_COMMIT_REF=main",
    "if_unavailable": "HOLD_UNVERIFIED_SOURCE_REVISION"
  },
  "issuer": "yard-workers",
  "audience": "rosevear-master",
  "tenant_boundary": "platform_shell",
  "legacy_integration_v1": {
    "app_id": "yard-workers",
    "method": "GET",
    "allowed_paths": ["/api/integration/v1/health", "/api/integration/v1/capabilities"],
    "authorization": "source_owned_required"
  },
  "transport": {"origin": null, "manifest_path": "/.well-known/rosevear-integration-manifest.json", "redirects": "DENY"},
  "requested_scope": "public_nonsecret_discovery_only",
  "failure_behavior": "HOLD_AND_QUARANTINE",
  "signature": {"algorithm": "Ed25519", "key_id": null, "value": null, "state": "AWAITING_INDEPENDENT_SOURCE_SIGNER"},
  "connection_state": "DISCONNECTED / HOLD"
}
